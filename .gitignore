# ─── Build outputs ──────────────────────────────────────────────
# Regenerated on every `node render.js`. Each user produces their
# own; never check these in. The PDFs (resume-color.pdf and
# resume-grayscale.pdf) are written into dist/ alongside the HTML
# and other build artifacts.
dist/

# ─── Private data ───────────────────────────────────────────────
# The committed `data/resume_default.yml` is a placeholder. Real resume
# data lives in `data/resume.local.yml`, which stays local only.
# Its matching snapshot fixtures (color + grayscale variants)
# are also private.
data/resume.local.yml
tests/fixtures/expected_resume-color.local.pdf
tests/fixtures/expected_resume-grayscale.local.pdf

# ─── Test artifacts ─────────────────────────────────────────────
# Diff images written when a snapshot test fails. They're useful
# for debugging the failure but shouldn't pollute history.
# Pattern matches diff_color_pageN.png and diff_grayscale_pageN.png.
tests/fixtures/diff_*.png

# ─── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
# Virtual environments, in case you ever spin one up.
venv/
.venv/
env/
# Coverage artifacts.
htmlcov/
.coverage
.coverage.*

# ─── Node ───────────────────────────────────────────────────────
# Reinstalled by `npm install` from package-lock.json.
node_modules/
# Test coverage artifacts.
coverage/
.nyc_output/

# ─── Secrets / environment overrides ────────────────────────────
# Defensive — not currently used, but a common Git footgun.
.env
.env.*
!.env.example

# ─── Logs ───────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── Editor / OS ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.bak
.DS_Store
Thumbs.db
