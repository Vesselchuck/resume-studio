{%- import '_macros.j2' as m -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name.first }} {{ name.last }} — Resume</title>
  <meta name="author" content="{{ name.first }} {{ name.last }}">
  <meta name="description" content="{{ meta.description }}">

  <!-- Fonts: vendored Montserrat (assets/fonts/) is the source of
       truth — its @font-face rules in styles.css are the LAST
       declaration in cascade order, so they win when the woff2
       loads successfully. The Google Fonts CSS link below is a
       graceful-degradation fallback: if assets/fonts/ is missing
       or the request fails, the browser uses Google's @font-face
       rules instead. The CSS-API URL (css2?family=...) is the
       stable, version-agnostic endpoint — Google internally
       resolves it to current woff2 hashes, insulating us from URL
       drift on the underlying font files. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════════════
       This file is GENERATED by scripts/build.py from data/resume_default.yml
       (or data/resume.local.yml if present). Do NOT edit directly —
       changes will be overwritten on the next `node render.js`.

       Page placement (which content goes on which page) is computed
       automatically by the layout solver in render.js based on
       measured content heights. To change content, edit the YAML.
       To change page break behavior, edit the solver in render.js
       or the meta.maxPages cap in the YAML.
       ══════════════════════════════════════════════════════════════════ -->
  <main class="resume" aria-label="Resume">

{% for page in placement.pages %}
    <!-- ─────────────  PAGE {{ page.page_number }}  ───────────── -->
    <article class="page" aria-label="Resume page {{ page.page_number }}">

{%- if loop.first %}
      <header class="resume-header">
        <div class="header-left">
          <h1 class="name">
            <span class="name-first">{{ name.first }}</span>
            <span class="name-last">{{ name.last }}</span>
          </h1>
{%- if role %}
          <p class="name-role">{{ role | e }}</p>
{%- endif %}
        </div>
{%- if contact %}
        <address class="header-contact">
{%- if contact.address %}
          <span class="header-contact-address">{{ contact.address | e }}</span>
{%- endif %}
{%- for item in contact.rows %}
          <span class="header-contact-item">
{%- if item.href %}<a href="{{ item.href | e }}">{{ item.value | e }}</a>
{%- else %}{{ item.value | e }}
{%- endif %}
          </span>
{%- endfor %}
        </address>
{%- endif %}
      </header>

      <hr class="top-rule" aria-hidden="true">
{%- endif %}

      <div class="body-grid">

        <aside class="sidebar" aria-label="{% set headings = [] %}{% for entry in page.sidebar_blocks %}{% if not entry.continuation %}{{ headings.append(block_by_id[entry.block_id].heading) or '' }}{% endif %}{% endfor %}{{ headings | join(' and ') | e }}">
{{ m.render_sidebar_blocks(page.sidebar_blocks, block_by_id) }}
        </aside>

        <div class="main-col">
{{ m.render_main_sections(page.main_sections, summary, experience, education, job_by_id) }}
        </div>

      </div>
    </article>

{% endfor %}
  </main>

</body>
</html>
