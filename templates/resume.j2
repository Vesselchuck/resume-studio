{%- import '_macros.j2' as m -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=816, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ name.first }} {{ name.last }} — Resume</title>
  <meta name="author" content="{{ name.first }} {{ name.last }}">
  <meta name="description" content="{{ meta.description }}">

  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <meta name="theme-color" content="{{ accent }}">

  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ name.first }} {{ name.last }} — Resume">
  <meta property="og:description" content="{{ meta.description }}">
  <meta property="profile:first_name" content="{{ name.first }}">
  <meta property="profile:last_name" content="{{ name.last }}">

  <!-- Fonts: vendored Manrope (body) and Newsreader (display) loaded
       from fonts/ via @font-face rules in styles.css. Both are
       variable WOFF2 files covering the full weight range used in the
       document. License terms (SIL OFL 1.1) live alongside the woff2
       binaries at fonts/Manrope-OFL.txt and Newsreader-OFL.txt. -->
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════════════
       This file is GENERATED by build/build.py from data/resume.yml
       (or data/resume_default.yml). Do NOT edit directly —
       changes will be overwritten on the next `node resume.js`.

       Page placement (which content goes on which page) is computed
       automatically by the layout solver in resume.js based on
       measured content heights. To change content, edit the YAML.
       To change page break behavior, edit the solver in resume.js
       or the meta.maxPages cap in the YAML.
       ══════════════════════════════════════════════════════════════════ -->
  {#- READING ORDER. A screen reader follows the PDF's tags, and Chromium
      builds them in document order: page by page, and on each page the
      sidebar before the main column. So page 2's continued jobs came
      right after page 1's sidebar headings, and read as if they belonged
      to them. aria-owns reorders the tags without moving anything on the
      page: every page's main column, then every sidebar, so the jobs run
      on unbroken and a sidebar list split across pages reads as one.
      (Chromium tags from its accessibility tree, which honors aria-owns;
      checked on a test page and by tests/test_pdf_accessibility.py.)
      The column ids use underscores so no block or job id can equal one:
      those are kebab-case (build.ID_PATTERN), and a sidebar block called
      col-main-1 used to take the column's place in this list. -#}
  <main class="resume" aria-label="Resume"
        aria-owns="{% for p in placement.pages %}col_main_{{ p.page_number }} {% endfor %}
                   {%- for p in placement.pages %}col_side_{{ p.page_number }}{% if not loop.last %} {% endif %}{% endfor %}">

{% for page in placement.pages %}
    <!-- ─────────────  PAGE {{ page.page_number }}  ───────────── -->
    <article class="page" aria-label="Resume page {{ page.page_number }}">

{%- if loop.first %}
      <header class="resume-header">
        <div class="header-left">
          <h1 class="name">
            {#- One text run. As two spans (first, last) NVDA with Acrobat
                read two level-1 headings, "Gaius" and "Caesar", and left the
                name out of its heading list; and with only markup between
                two spans pypdf had read "GaiusCaesar". The last name moves
                0.002pt; no pixel changes by more than 2/255. #}
            <span class="name-text">{{ name.first }} {{ name.last }}</span>
          </h1>
{%- if role %}
          <p class="name-role">
            <span>{{ role }}</span>
          </p>
{%- endif %}
        </div>
{%- if contact %}
        <address class="header-contact">
{#- Both optional (the schema says so): under StrictUndefined a
    bare `if` on an absent key raises instead of being false. #}
{%- if contact.address is defined and contact.address %}
          <span class="header-contact-address">{{ contact.address }}</span>
{%- endif %}
{%- for item in contact.rows %}
          <span class="header-contact-item">
{%- if item.href is defined and item.href %}<a href="{{ item.href }}">{{ item.value }}</a>
{%- else %}{{ item.value }}
{%- endif %}
          </span>
{%- endfor %}
        </address>
{%- endif %}
      </header>

      <hr class="top-rule" aria-hidden="true">
{%- endif %}

      <div class="body-grid">

        <aside class="sidebar" id="col_side_{{ page.page_number }}" aria-label="{{ page.sidebar_aria }}">
{{ m.render_sidebar_blocks(page.sidebar_blocks, block_by_id) }}
        </aside>

        <div class="main-col" id="col_main_{{ page.page_number }}">
{{ m.render_main_sections(page.main_sections, summary, experience, education, job_by_id) }}
        </div>

      </div>

{%- if placement.pages | length > 1 %}
      {#- Page marker — bottom-right of every page on a multi-page resume.
          Suppressed for single-page output because "Page 1 of 1" is noise.
          aria-hidden because the surrounding <article aria-label="Resume
          page N"> already announces page transitions for screen readers;
          the visible "Page N of M" is for sighted readers only. -#}
      <footer class="page-footer entry-meta" aria-hidden="true">
        Page {{ page.page_number }} of {{ placement.pages | length }}
      </footer>
{%- endif %}
    </article>

{% endfor %}
  </main>

</body>
</html>
