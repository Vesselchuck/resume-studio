{%- import '_macros.j2' as m -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name.first }} {{ name.last }} — Resume</title>
  <meta name="author" content="{{ name.first }} {{ name.last }}">
  <meta name="description" content="{{ meta.description }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,700;1,500&display=swap">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════════════
       This file is GENERATED by scripts/build.py from data/resume_default.yml
       (or data/resume.local.yml if present). Do NOT edit directly —
       changes will be overwritten on the next `node render.js`.

       Page placement (which content goes on which page) is computed
       automatically by the layout solver in render.js based on
       measured content heights. To change content, edit the YAML.
       To change page break behavior, edit the solver in render.js
       or the meta.maxPages cap in the YAML.
       ══════════════════════════════════════════════════════════════════ -->
  <main class="resume" aria-label="Resume">

{% for page in placement.pages %}
    <!-- ─────────────  PAGE {{ page.page_number }}  ───────────── -->
    <article class="page" aria-label="Resume page {{ page.page_number }}">

{%- if loop.first %}
      <header class="resume-header">
        <h1 class="name">
          <span class="name-first">{{ name.first }}</span>
          <span class="name-last">{{ name.last }}</span>
        </h1>
      </header>

      <hr class="top-rule" aria-hidden="true">
{%- endif %}

      <div class="body-grid">

        <aside class="sidebar" aria-label="{% set headings = [] %}{% for entry in page.sidebar_blocks %}{% if not entry.continuation %}{{ headings.append(block_by_id[entry.block_id].heading) or '' }}{% endif %}{% endfor %}{{ headings | join(' and ') | e }}">
{{ m.render_sidebar_blocks(page.sidebar_blocks, block_by_id) }}
        </aside>

        <div class="main-col">
{{ m.render_main_sections(page.main_sections, summary, experience, education, job_by_id) }}
        </div>

      </div>
    </article>

{% endfor %}
  </main>

</body>
</html>
