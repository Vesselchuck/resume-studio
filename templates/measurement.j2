{#-
  measurement.j2 — Single-page flowing layout for the layout solver.

  This template renders ALL sidebar blocks and ALL jobs/bullets in a
  single tall page (no page breaks). The solver in resume.js opens
  this in Playwright, measures the height/position of every
  data-measure element, and produces the placement that drives the
  final build.

  The structure mirrors the final layout (two-column body grid,
  same widths) so measured heights are realistic. Only the
  `body.measurement-mode` class differs, which CSS uses to disable
  fixed page height so content can flow.

  Headings: each .section-heading holds its text once, in a <span>,
  exactly as the final templates do (see render_sidebar_block in
  templates/_macros.j2 for why it is no longer written twice).

  Markers (emitted by _macros.j2 macros when called with measure=True):
    data-measure="resume-header"  — page-1 header (eats vertical space)
    data-measure="block"          — a sidebar block (the whole section)
    data-measure="separator"      — an <hr class="section-sep">
    data-measure="item"           — a sidebar block's heading-or-row item
    data-measure="block-heading"  — the heading inside a sidebar block
    data-measure="section"        — main-column section
    data-measure="section-heading"— main column section heading
    data-measure="summary-text"   — summary section text body
    data-measure="job"            — a single job article
    data-measure="job-header"     — header (title + meta) inside a job
    data-measure="bullet"         — single bullet <li>
    data-measure="edu-item"       — single education item

  Each measurable element also has data-id (block_id, job_id) where
  relevant so the solver can reference them in placement.json.
-#}
{%- import '_macros.j2' as m -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name.first }} {{ name.last }} — Resume (measurement)</title>
  <meta name="description" content="{{ meta.description }}">

  <!-- Fonts: vendored Manrope (body) and Newsreader (display) loaded
       from fonts/ via @font-face rules in styles.css. Both are
       variable WOFF2 files covering the full weight range used in the
       document. License terms (SIL OFL 1.1) live alongside the woff2
       binaries at fonts/Manrope-OFL.txt and Newsreader-OFL.txt. -->
  <link rel="stylesheet" href="styles.css">
</head>
<body class="measurement-mode">

  <!-- This is the MEASUREMENT-MODE HTML. It is NOT the final paginated
       output. The layout solver in resume.js opens this in Playwright,
       measures positions of [data-measure] elements, and writes
       dist/placement.json which drives the final build. -->
  <main class="resume" aria-label="Resume (measurement)">

    <article class="page" aria-label="Measurement page" data-measurement-page>

      <header class="resume-header" data-measure="resume-header">
        <div class="header-left">
          <h1 class="name">
            {#- One text run. As two spans (first, last) NVDA with Acrobat
                read two level-1 headings, "Gaius" and "Caesar", and left the
                name out of its heading list; and with only markup between
                two spans pypdf had read "GaiusCaesar". Pixel-identical. #}
            <span class="name-text">{{ name.first }} {{ name.last }}</span>
          </h1>
{%- if role %}
          <p class="name-role">
            <span>{{ role }}</span>
          </p>
{%- endif %}
        </div>
{%- if contact %}
        <address class="header-contact">
{#- Both optional (the schema says so): under StrictUndefined a
    bare `if` on an absent key raises instead of being false. #}
{%- if contact.address is defined and contact.address %}
          <span class="header-contact-address">{{ contact.address }}</span>
{%- endif %}
{%- for item in contact.rows %}
          <span class="header-contact-item">
{%- if item.href is defined and item.href %}<a href="{{ item.href }}">{{ item.value }}</a>
{%- else %}{{ item.value }}
{%- endif %}
          </span>
{%- endfor %}
        </address>
{%- endif %}
      </header>

      <hr class="top-rule" aria-hidden="true">

      <div class="body-grid">

        <aside class="sidebar" aria-label="Sidebar (measurement)">
{# Loop raw blocks (no placement) and call render_sidebar_block with
   measure=True so each block emits its data-measure attributes. The
   inter-block separator gets data-measure="separator" — production
   HTML doesn't need that attribute, so this loop is inlined here
   instead of going through render_sidebar_blocks. #}
{% for b in sidebar_blocks -%}
{%- if not loop.first %}
<hr class="section-sep" data-measure="separator">
{% endif -%}
{{ m.render_sidebar_block(b, measure=True) }}
{%- endfor %}
        </aside>

        <div class="main-col">
{# Three main-column sections (summary / experience / education) are
   inlined here rather than going through render_main_section because
   they need the measurement-specific data-measure="section" and
   data-section-type="…" attributes on the <section>, plus
   data-measure="section-heading" on the <h2>, that the production
   macro doesn't emit. The INNER content (jobs, edu items) uses the
   shared macros with measure=True. #}

          <section class="block" data-measure="section" data-section-type="summary">
            <h2 class="section-heading" data-measure="section-heading"><span>{{ summary.heading }}</span></h2>
            <p class="summary-text" data-measure="summary-text">{{ summary.text | e | md | safe }}</p>
          </section>

          <hr class="section-sep" data-measure="separator">

          <section class="block experience" data-measure="section" data-section-type="experience">
            <h2 class="section-heading" data-measure="section-heading"><span>{{ experience.heading }}</span></h2>
{% for j in experience.jobs -%}
{%- if not loop.first %}{{ "\n" }}{% endif %}
{{ m.render_job(j, measure=True) -}}
{% endfor %}
          </section>

          <hr class="section-sep" data-measure="separator">

          <section class="block" data-measure="section" data-section-type="education">
            <h2 class="section-heading" data-measure="section-heading"><span>{{ education.heading }}</span></h2>
{%- for item in education['items'] %}
{{ m.render_edu_item(item, measure=True) }}
{%- endfor %}
          </section>

        </div>

      </div>
    </article>

  </main>

</body>
</html>
