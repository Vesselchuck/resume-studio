{#-
  letter.j2 — Single-column cover letter.

  Reuses the resume's page chrome verbatim: the <article class="page">
  fixed US-Letter sheet, the <header class="resume-header"> (name +
  role on the left, contact block on the right), and the <hr
  class="top-rule"> beneath it. Everything below the top rule is the
  letter itself — one flowing column of prose, NOT the resume's two-
  column body grid. So a person's resume and cover letter share an
  identical header and look like a matched pair.

  The header block below is intentionally byte-for-byte the same as
  templates/resume.j2's page-1 header. If you change the header in one
  place, change it in the other (or factor it into _macros.j2). It is
  duplicated here rather than imported so this template has no
  dependency on the resume's placement-driven macros.

  Rendered by build/build_letter.py to dist/letter.html;
  letter.js then prints it to the two letter PDFs in
  dist/, which are named from the profile's name.first/name.last
  (see build/_output_name.py).

  This is a SINGLE fixed sheet. Cover letters are one page by
  convention; like the resume, the .page uses overflow: hidden, so if
  the letter runs long it clips at the sheet's bottom margin — the
  on-screen cue to trim it.
-#}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=816, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ name.first }} {{ name.last }} — Cover Letter</title>
  <meta name="author" content="{{ name.first }} {{ name.last }}">
  <meta name="description" content="{{ meta.description }}">

  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <meta name="theme-color" content="{{ accent }}">

  <meta property="og:type" content="profile">
  <meta property="og:title" content="{{ name.first }} {{ name.last }} — Cover Letter">
  <meta property="og:description" content="{{ meta.description }}">
  <meta property="profile:first_name" content="{{ name.first }}">
  <meta property="profile:last_name" content="{{ name.last }}">

  <!-- Fonts: vendored Manrope (body) and Newsreader (display) loaded
       from fonts/ via @font-face rules in styles.css. License terms
       (SIL OFL 1.1) live at fonts/Manrope-OFL.txt and
       fonts/Newsreader-OFL.txt. -->
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════════════
       This file is GENERATED by build/build_letter.py from
       data/letter.yml (or data/letter_default.yml).
       Do NOT edit directly — changes are overwritten on the next
       `node letter.js`. To change content, edit the YAML.
       ══════════════════════════════════════════════════════════════════ -->
  <main class="resume letter-page" aria-label="Cover letter">

    <article class="page" aria-label="Cover letter">

      <header class="resume-header">
        <div class="header-left">
          <h1 class="name">
            <span class="name-first">{{ name.first }}</span>
            <span class="name-last">{{ name.last }}</span>
          </h1>
{%- if role %}
          <p class="name-role">
            <span class="visually-hidden">{{ role }}</span>
            <span aria-hidden="true">{{ role }}</span>
          </p>
{%- endif %}
        </div>
{%- if contact %}
        <address class="header-contact">
{%- if contact.address %}
          <span class="header-contact-address">{{ contact.address }}</span>
{%- endif %}
{%- for item in contact.rows %}
          <span class="header-contact-item">
{%- if item.href %}<a href="{{ item.href }}">{{ item.value }}</a>
{%- else %}{{ item.value }}
{%- endif %}
          </span>
{%- endfor %}
        </address>
{%- endif %}
      </header>

      <hr class="top-rule" aria-hidden="true">

      <section class="letter" aria-label="Letter">
{#- The date is stamped by the build, never authored, so it is
     always present and is always a real calendar day. That is what
     makes <time datetime> honest here: the printed form follows the
     reader's language, the attribute stays ISO 8601. -#}
{%- if letter.date %}
        <p class="letter-date">
          <time datetime="{{ letter.date_iso }}">{{ letter.date }}</time>
        </p>
{%- endif %}
{%- if letter.recipient %}
        <address class="letter-recipient">
{%- for line in letter.recipient %}
          <span>{{ line }}</span>
{%- endfor %}
        </address>
{%- endif %}
{#- One block of prose. The greeting and the sign-off are the first
     and last paragraphs of it, not separate fields — see
     resolve_letter for why. -#}
        <div class="letter-body">
{%- for para in letter.body %}
          <p>{{ para | e | md | safe }}</p>
{%- endfor %}
        </div>

{#- The typed name. Not authored anywhere: resolve_letter fills it
     from `name`, which the shared profile supplies. -#}
        <p class="letter-signature">{{ letter.signature }}</p>
      </section>

    </article>

  </main>

</body>
</html>
