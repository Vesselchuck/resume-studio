{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resume Studio",
  "version": "0.8.1",
  "identifier": "com.resume-studio.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/": "build/",
      "../data/resume_default.yml": "data/resume_default.yml",
      "../data/letter_default.yml": "data/letter_default.yml",
      "../data/_profile_default.yml": "data/_profile_default.yml",
      "../fonts/": "fonts/",
      "../styles/": "styles/",
      "../templates/": "templates/",
      "../ui/": "ui/",
      "../package.json": "package.json",
      "../resume.js": "resume.js",
      "../letter.js": "letter.js",
      "../requirements.txt": "requirements.txt"
    }
  }
}
